# ---- Fadeprint configuration. Copy to .env. Everything is optional in demo/dev mode. ----
ENV=development            # development | production
DEMO_MODE=true             # seeds demo accounts + sample data; MUST be false in production
PUBLIC_URL=http://localhost:3000
# Required in production (32 random bytes, base64):
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
SECRET_KEY=
DATA_KEY=
COOKIE_SECURE=false
# empty = SQLite. Prod: postgresql+psycopg://fadeprint:PASS@db:5432/fadeprint
DATABASE_URL=

# Mail (empty = dev outbox at /api/dev/outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Fadeprint <no-reply@fadeprint.example>

# Sign in with Google / Apple (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
WEBAUTHN_RP_ID=localhost

# Stripe (test keys work fully; live keys only in production .env)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX=false

# Web push (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# AI (classic = no AI at all)
AI_MODE=classic
AI_PROVIDER=none
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# SMS for phone ownership codes (none = demo/dev outbox only)
SMS_PROVIDER=none
SMS_API_KEY=
SMS_SENDER=Fadeprint
# OCR: path to tesseract if not on PATH (Windows: C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=

# Optional source keys (can also be entered in Admin -> Schluessel)
BRAVE_API_KEY=
SAFE_BROWSING_KEY=
URLHAUS_AUTH_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
HIBP_API_KEY=
TINEYE_API_KEY=
