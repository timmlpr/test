# Automatic HTTPS (Let's Encrypt) for LZ_DOMAIN. API is proxied directly (SSE unbuffered), everything else to Next.js.
{
	email {$ACME_EMAIL}
}

{$LZ_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 210MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Permissions-Policy "microphone=(self), camera=(self), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
		-Server
	}
	@api path /api/*
	handle @api {
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy frontend:3000
	}
}
