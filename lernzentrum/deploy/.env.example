# Copy to deploy/.env – hetzner-setup.sh generates this file automatically with random secrets.
LZ_DOMAIN=lernen.example.de
ACME_EMAIL=
POSTGRES_PASSWORD=change-me
# 32 random bytes, base64 (openssl rand -base64 32) – encrypts API keys, tokens and all stored files
LZ_MASTER_KEY=
LZ_SESSION_SECRET=
BACKUP_PASSPHRASE=
BACKUP_KEEP_DAYS=14
LZ_DEMO_MODE=false
