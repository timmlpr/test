# Backend environment (local development needs none of these – keys are generated under backend/data/).
# Third-party API keys (Groq, Gemini) are NOT configured here: enter them in the app's setup wizard.
LZ_ENV=development
LZ_DATABASE_URL=sqlite:///./data/lernzentrum.db
LZ_DEMO_MODE=true
LZ_PUBLIC_URL=http://localhost:3000
# production only (deploy/.env is generated by deploy/hetzner-setup.sh):
# LZ_MASTER_KEY=<openssl rand -base64 32>
# LZ_SESSION_SECRET=<openssl rand -base64 32>
